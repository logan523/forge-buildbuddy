# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# local sqlite / data
*.db
*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent / local review artifacts (root-level only — docs/designs/ is tracked)
/ceo-plans/
decisions.active.json
decisions.jsonl
/designs/
*-reviews.jsonl
logansilver-*.md
.gstack/

# firmware build artifacts (PlatformIO / Arduino — large binaries)
scripts/firmware-src/**/build/
scripts/firmware-src/**/.pio/
# generated build-provenance header — regenerated by scripts/compile-firmware.mjs
# on every compile from a hash of the sketch's own source, never hand-edited
scripts/firmware-src/**/build_id.h

# local IDE / OS
.idea/
.vscode/
*.swp
# real Wi-Fi credentials — template lives at wifi_secrets.example.h
scripts/firmware-src/**/wifi_secrets.h

# Higgsfield companion skills (installed via `npx skills add higgsfield-ai/skills`).
# Local tooling, reinstallable, not project source.
.agents/
.claude/skills/
skills-lock.json
