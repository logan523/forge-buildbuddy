// EST. Set DAYLIGHT_OFFSET_HOURS to 0 when daylight saving ends (~Nov), back
// to 1 when it resumes (~Mar) — Florida currently observes DST.
const int GMT_OFFSET_HOURS      = -5;
const int DAYLIGHT_OFFSET_HOURS = 1;

// The one-time message Mia sees the first time the clock finishes loading
// real data after power-up (not shown again until the next power cycle).
const char* WELCOME_MESSAGE = "Hi Mia :)";

// The "will you marry me?" screen is live — it joins the same rotation as
// the other special full-screen moments (Mars-and-back, shooting star,
// weather scene), just weighted much rarer than the others (see
// PROPOSAL_ODDS below). It plays for a while, then goes back to the normal
// clock, same as the rest. Flip back to false and reflash to make it
// impossible again.
#define PROPOSAL_ELIGIBLE true

// Your rotating messages — one takes over the whole screen at random every
// ~5 minutes. Add as many as you like; long ones wrap across extra lines
// automatically.
const char* MESSAGES[] = {
  "Hi Mia! <3",
  "You, me, Buckskin Tavern?",
  "You, me, Beccofino Saturday?",
  "I MISS YOU MF",
  "Missing PopUp w/ you rn",
