# AI
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Auth (NextAuth.js) — get credentials from:
# GitHub: https://github.com/settings/developers
# Google: https://console.cloud.google.com/apis/credentials
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET= # generate with: openssl rand -base64 32

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Nexar/Octopart (optional live distributor pricing on /api/analyze)
# Without these, Forge uses catalog price bands + precise multi-vendor search links.
# Get credentials: https://portal.nexar.com/
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# Optional AI beauty mesh underlay (display only — never product authority)
# Viewer shows "Gen beauty" when either key is set.
# Meshy: https://docs.meshy.ai/  (preferred)
MESHY_API_KEY=
# Tripo: https://platform.tripo3d.ai/
TRIPO_API_KEY=
